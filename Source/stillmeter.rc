1 24 "stillmeter.manifest"
101 ICON "stillmeter.ico"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
 BEGIN
   BLOCK "StringFileInfo"
   BEGIN
     BLOCK "040904b0"
     BEGIN
       VALUE "FileDescription", "Stillmeter system monitor"
       VALUE "FileVersion", "1.1.0.0"
       VALUE "InternalName", "Stillmeter"
       VALUE "OriginalFilename", "Stillmeter.exe"
       VALUE "ProductName", "Stillmeter"
       VALUE "ProductVersion", "1.0.0"
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x0409, 1200
   END
 END
