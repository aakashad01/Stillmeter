#include "resource.h"

1 24 "stillmeter.manifest"
101 ICON "stillmeter.ico"

1 VERSIONINFO
 FILEVERSION 1,5,4,0
 PRODUCTVERSION 1,5,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
 BEGIN
   BLOCK "StringFileInfo"
   BEGIN
     BLOCK "040904b0"
     BEGIN
       VALUE "FileDescription", "Stillmeter system monitor"
       VALUE "FileVersion", "1.5.4.0"
       VALUE "InternalName", "Stillmeter"
       VALUE "OriginalFilename", "Stillmeter.exe"
       VALUE "ProductName", "Stillmeter"
       VALUE "ProductVersion", "1.5.4.0"
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x0409, 1200
   END
 END


IDD_STRIP_APPEARANCE DIALOGEX 0, 0, 333, 256
STYLE 0x80000000 | 0x00C00000 | 0x00080000 | 0x00000800 | 0x00000040
EXSTYLE 0x00000001
CAPTION "Taskbar strip appearance"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Preset", -1, 12, 16, 33, 10
    COMBOBOX IDC_STRIP_PRESET, 48, 12, 104, 80, 0x00010000 | 0x0003 | 0x00200000
    GROUPBOX "Metrics", -1, 12, 38, 148, 83
    AUTOCHECKBOX "Upload", IDC_STRIP_UPLOAD, 21, 52, 60, 11, 0x00010000
    AUTOCHECKBOX "Download", IDC_STRIP_DOWNLOAD, 85, 52, 70, 11, 0x00010000
    AUTOCHECKBOX "CPU", IDC_STRIP_CPU, 21, 68, 60, 11, 0x00010000
    AUTOCHECKBOX "Memory", IDC_STRIP_MEMORY, 85, 68, 70, 11, 0x00010000
    AUTOCHECKBOX "GPU", IDC_STRIP_GPU, 21, 84, 60, 11, 0x00010000
    AUTOCHECKBOX "CPU frequency", IDC_STRIP_CPU_FREQUENCY, 85, 84, 70, 11, 0x00010000
    AUTOCHECKBOX "Total traffic", IDC_STRIP_TOTAL, 21, 100, 60, 11, 0x00010000
    GROUPBOX "Layout", -1, 171, 38, 150, 83
    LTEXT "R&ows", -1, 180, 55, 53, 10
    COMBOBOX IDC_STRIP_ROWS, 236, 51, 76, 65, 0x00010000 | 0x0003
    LTEXT "Taskbar &side", -1, 180, 75, 53, 10
    COMBOBOX IDC_STRIP_ALIGNMENT, 236, 71, 76, 65, 0x00010000 | 0x0003
    LTEXT "Font &weight", -1, 180, 95, 53, 10
    COMBOBOX IDC_STRIP_WEIGHT, 236, 91, 76, 65, 0x00010000 | 0x0003
    GROUPBOX "Size and spacing (px)", -1, 12, 129, 309, 38
    LTEXT "&Font size", -1, 21, 145, 47, 10
    EDITTEXT IDC_STRIP_FONT_SIZE, 68, 142, 29, 14, 0x00010000 | 0x2000
    LTEXT "&Column gap", -1, 113, 145, 54, 10
    EDITTEXT IDC_STRIP_COLUMN_GAP, 169, 142, 29, 14, 0x00010000 | 0x2000
    LTEXT "Row &gap", -1, 218, 145, 48, 10
    EDITTEXT IDC_STRIP_ROW_GAP, 270, 142, 29, 14, 0x00010000 | 0x2000
    LTEXT "Preview with sample readings", -1, 12, 175, 168, 10
    CONTROL "", IDC_STRIP_PREVIEW, "Static", 0x0000000D, 12, 188, 309, 29
    LTEXT "", IDC_STRIP_HINT, 12, 221, 309, 10
    PUSHBUTTON "&Defaults", IDC_STRIP_DEFAULTS, 12, 235, 54, 15
    PUSHBUTTON "&Apply", IDC_STRIP_APPLY, 161, 235, 49, 15
    DEFPUSHBUTTON "OK", 1, 217, 235, 49, 15
    PUSHBUTTON "Cancel", 2, 272, 235, 49, 15
END

IDD_NETWORK_ADAPTER DIALOGEX 0, 0, 305, 120
STYLE 0x80000000 | 0x00C00000 | 0x00080000 | 0x00000800 | 0x00000040
EXSTYLE 0x00000001
CAPTION "Network adapter"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Measure traffic on", -1, 12, 13, 280, 10
    COMBOBOX IDC_NETWORK_ADAPTER, 12, 27, 281, 105, 0x00010000 | 0x0003 | 0x00200000
    LTEXT "Auto select follows an active adapter using Windows routing.", -1, 12, 52, 281, 12
    LTEXT "Changing the selection resets the traffic graph and total.", -1, 12, 69, 281, 12
    DEFPUSHBUTTON "OK", 1, 188, 94, 49, 15
    PUSHBUTTON "Cancel", 2, 244, 94, 49, 15
END
