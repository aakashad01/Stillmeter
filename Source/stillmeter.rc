#include "resource.h"

1 24 "stillmeter.manifest"
101 ICON "stillmeter.ico"

1 VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
 BEGIN
   BLOCK "StringFileInfo"
   BEGIN
     BLOCK "040904b0"
     BEGIN
       VALUE "FileDescription", "Stillmeter system monitor"
       VALUE "FileVersion", "1.4.0.0"
       VALUE "InternalName", "Stillmeter"
       VALUE "OriginalFilename", "Stillmeter.exe"
       VALUE "ProductName", "Stillmeter"
       VALUE "ProductVersion", "1.4.0.0"
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x0409, 1200
   END
 END

IDD_STRIP_APPEARANCE DIALOGEX 0, 0, 246, 151
STYLE 0x80000000 | 0x00C00000 | 0x00080000 | 0x00000800 | 0x00000040
EXSTYLE 0x00000001
CAPTION "Taskbar strip appearance"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Font size", -1, 12, 15, 84, 10
    EDITTEXT IDC_STRIP_FONT_SIZE, 101, 12, 37, 14, 0x00010000 | 0x2000
    LTEXT "9 to 20 px", -1, 149, 15, 84, 10
    LTEXT "&Column spacing", -1, 12, 38, 84, 10
    EDITTEXT IDC_STRIP_COLUMN_GAP, 101, 35, 37, 14, 0x00010000 | 0x2000
    LTEXT "0 to 24 px", -1, 149, 38, 84, 10
    LTEXT "&Row spacing", -1, 12, 61, 84, 10
    EDITTEXT IDC_STRIP_ROW_GAP, 101, 58, 37, 14, 0x00010000 | 0x2000
    LTEXT "0 to 12 px", -1, 149, 61, 84, 10
    LTEXT "Values scale with Windows display settings. Text shrinks when the taskbar has limited space.", -1, 12, 84, 222, 24
    PUSHBUTTON "&Defaults", IDC_STRIP_DEFAULTS, 12, 124, 54, 16
    PUSHBUTTON "&Apply", IDC_STRIP_APPLY, 78, 124, 48, 16
    DEFPUSHBUTTON "OK", 1, 132, 124, 48, 16
    PUSHBUTTON "Cancel", 2, 186, 124, 48, 16
END
